<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>
<VBox xmlns:fx="http://javafx.com/fxml/1" fx:controller="play.controller.ShopController"
      fx:id="shopRoot" spacing="12">
    <Label text="Shop" styleClass="title"/>
    <HBox spacing="8" styleClass="shop-row">
        <Button fx:id="btnAtar" text="Atar - 3 coins (Disable impact waves 10s)" onAction="#onAtar"/>
        <Label fx:id="lblAtarMsg" text=""/>
    </HBox>
    <HBox spacing="8" styleClass="shop-row">
        <Button fx:id="btnAiryaman" text="Airyaman - 4 coins (Disable collisions 5s)" onAction="#onAiryaman"/>
        <Label fx:id="lblAiryMsg" text=""/>
    </HBox>
    <HBox spacing="8" styleClass="shop-row">
        <Button fx:id="btnAnahita" text="Anahita - 5 coins (Reset noise)" onAction="#onAnahita"/>
        <Label fx:id="lblAnaMsg" text=""/>
    </HBox>
    <HBox spacing="8" styleClass="shop-row">
        <Button fx:id="btnAergia" text="Scroll of Aergia - 10 coins (Zero accel point 20s)" onAction="#onAergia"/>
        <Label fx:id="lblAergiaMsg" text=""/>
    </HBox>
    <HBox spacing="8">
        <Label fx:id="coinsInfo" text="Your coins: 0"/>
        <Region HBox.hgrow="ALWAYS"/>
        <Button fx:id="closeBtn" text="Close" onAction="#onClose" styleClass="danger"/>
    </HBox>
</VBox>
