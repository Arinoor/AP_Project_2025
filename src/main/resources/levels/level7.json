    { "id": "LOOP_B_IN",  "device": "LOOP_B", "x": 800, "y": 460, "shape": "triangle", "io": "in" },
    { "id": "LOOP_B_OUT", "device": "LOOP_B", "x": 840, "y": 460, "shape": "triangle", "io": "out" },

    { "id": "VPN_IN",     "device": "VPN_1", "x": 1020, "y": 420, "shape": "square",   "io": "in" },
    { "id": "VPN_OUT",    "device": "VPN_1", "x": 1060, "y": 420, "shape": "triangle", "io": "out" },

    { "id": "REF_LEFT_IN",  "device": "REF_LEFT",   "x": 1240, "y": 120, "shape": "square",   "io": "in", "reference": true },
    { "id": "REF_LEFT_IN2", "device": "REF_LEFT",   "x": 1240, "y": 140, "shape": "square",   "io": "in", "reference": true },

    { "id": "REF_BOT_IN",   "device": "REF_BOTTOM", "x": 1240, "y": 420, "shape": "triangle", "io": "in", "reference": true },
    { "id": "REF_BOT_IN2",  "device": "REF_BOTTOM", "x": 1240, "y": 440, "shape": "square",   "io": "in", "reference": true },

    { "id": "P_SMALL_OUT",  "device": "P_SMALL", "x": 140, "y": 320, "shape": "square", "io": "out" },
    { "id": "P_SECURE_OUT", "device": "P_SECURE","x": 140, "y": 500, "shape": "square", "io": "out" }
  ],

  "links": [
    { "id": "L1",  "from": { "device": "P_HEAVY", "port": "P_HEAVY_OUT" }, "to": { "device": "DIST_A",   "port": "DIST_IN" }, "bends": [] },

    { "id": "L2a", "from": { "device": "DIST_A", "port": "DIST_OUT_A" }, "to": { "device": "TRANS_UP",   "port": "TRANS_UP_IN" }, "bends": [] },
    { "id": "L2b", "from": { "device": "DIST_A", "port": "DIST_OUT_B" }, "to": { "device": "TRANS_DOWN", "port": "TRANS_DOWN_IN" }, "bends": [] },

    { "id": "L3a", "from": { "device": "TRANS_UP",   "port": "TRANS_UP_OUT" }, "to": { "device": "MERGE_HUB", "port": "MERGE_IN" }, "bends": [] },
    { "id": "L3b", "from": { "device": "TRANS_DOWN", "port": "TRANS_DOWN_OUT" }, "to": { "device": "SAB",       "port": "SAB_IN" }, "bends": [] },

    { "id": "L4",  "from": { "device": "SAB", "port": "SAB_OUT" }, "to": { "device": "LOOP_A", "port": "LOOP_A_IN" }, "bends": [] },

    { "id": "L5",  "from": { "device": "LOOP_A", "port": "LOOP_A_OUT" }, "to": { "device": "LOOP_B", "port": "LOOP_B_IN" }, "bends": [] },
    { "id": "L6",  "from": { "device": "LOOP_B", "port": "LOOP_B_OUT" }, "to": { "device": "TRANS_DOWN", "port": "TRANS_DOWN_IN" }, "bends": [] },

    { "id": "L7",  "from": { "device": "MERGE_HUB", "port": "MERGE_OUT" }, "to": { "device": "REF_LEFT",   "port": "REF_LEFT_IN" }, "bends": [] },

    { "id": "L8",  "from": { "device": "TRANS_DOWN", "port": "TRANS_DOWN_OUT" }, "to": { "device": "VPN_1", "port": "VPN_IN" }, "bends": [] },
    { "id": "L9",  "from": { "device": "VPN_1", "port": "VPN_OUT" }, "to": { "device": "REF_BOTTOM", "port": "REF_BOT_IN" }, "bends": [] },

    { "id": "L10", "from": { "device": "P_SMALL", "port": "P_SMALL_OUT" }, "to": { "device": "SAB", "port": "SAB_IN" }, "bends": [] },

    { "id": "L11", "from": { "device": "P_SECURE", "port": "P_SECURE_OUT" }, "to": { "device": "TRANS_UP", "port": "TRANS_UP_IN" }, "bends": [] },

    { "id": "L12", "from": { "device": "TRANS_UP", "port": "TRANS_UP_OUT" }, "to": { "device": "REF_LEFT", "port": "REF_LEFT_IN2" }, "bends": [] },
    { "id": "L13", "from": { "device": "P_SECURE", "port": "P_SECURE_OUT" }, "to": { "device": "REF_BOTTOM", "port": "REF_BOT_IN2" }, "bends": [] }
  ],

  "notes": "Balanced-port heavy/distribute/merge test. For each port type (square and triangle) total inputs == total outputs.\n\nKey checks:\n1) P_HEAVY produces heavies (heavySize=8). Distribute (DIST_A) will split heavies into colored BITPACKETs.\n2) MERGE_HUB reassembles bitpackets arriving within MERGE_WAIT_SECONDS into HEAVY of size=k.\n3) LOOP_A ↔ LOOP_B ↔ TRANS_DOWN path encourages repeated heavy passes across same links (observe link destruction after 3 heavy passes).\n4) HEAVY arrival at a system with queued packets (SAB) should clear that system queue immediately.\n5) VPN_1 converts messaging packets into PROTECTED variants; P_SECURE and P_SMALL create queue pressure to exercise heavy destruction.\n\nTuning knobs: GameBalance.MERGE_WAIT_SECONDS, GameBalance.HEAVY_MAX_PASSES, GameBalance.HEAVY_PORT_TOGGLE_PROB, heavy speeds. Adjust coordinates if your scene uses a different origin/scale."
}
