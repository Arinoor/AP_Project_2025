    { "id": "DIST_OUT_B",  "device": "DIST_A",   "x": 420, "y": 170, "shape": "square",   "io": "out" },

    { "id": "TRANS_UP_IN",  "device": "TRANS_UP",  "x": 620, "y": 80,  "shape": "triangle", "io": "in" },
    { "id": "TRANS_UP_OUT", "device": "TRANS_UP",  "x": 660, "y": 80,  "shape": "square",   "io": "out" },

    { "id": "TRANS_DOWN_IN",  "device": "TRANS_DOWN", "x": 620, "y": 220, "shape": "square",  "io": "in" },
    { "id": "TRANS_DOWN_OUT", "device": "TRANS_DOWN", "x": 660, "y": 220, "shape": "triangle","io": "out" },

    { "id": "MERGE_IN",   "device": "MERGE_HUB", "x": 900, "y": 150, "shape": "triangle", "io": "in" },
    { "id": "MERGE_OUT",  "device": "MERGE_HUB", "x": 940, "y": 150, "shape": "square",   "io": "out" },

    { "id": "SAB_IN",     "device": "SAB", "x": 360, "y": 320, "shape": "square", "io": "in" },
    { "id": "SAB_OUT",    "device": "SAB", "x": 400, "y": 320, "shape": "square", "io": "out" },

    { "id": "LOOP_A_IN",  "device": "LOOP_A", "x": 600, "y": 460, "shape": "triangle", "io": "in" },
