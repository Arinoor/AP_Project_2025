    { "id": "B_OUT_TR",  "device": "SRC_B", "x": 220, "y": 300, "shape": "triangle", "io": "out" },

    { "id": "SEC_OUT_SQ","device": "SRC_SEC", "x": 220, "y": 420, "shape": "square",   "io": "out" },
    { "id": "SEC_OUT_TR","device": "SRC_SEC", "x": 220, "y": 460, "shape": "triangle", "io": "out" },

    { "id": "VPN_IN_SQ",  "device": "VPN_1", "x": 560, "y": 210, "shape": "square",   "io": "in"  },
    { "id": "VPN_OUT_SQ", "device": "VPN_1", "x": 600, "y": 210, "shape": "square",   "io": "out" },
    { "id": "VPN_IN_TR",  "device": "VPN_1", "x": 560, "y": 250, "shape": "triangle", "io": "in"  },
    { "id": "VPN_OUT_TR", "device": "VPN_1", "x": 600, "y": 250, "shape": "triangle", "io": "out" },

    { "id": "MIX_IN_SQ",  "device": "MIX",   "x": 760, "y": 210, "shape": "square",   "io": "in"  },
    { "id": "MIX_OUT_SQ", "device": "MIX",   "x": 800, "y": 210, "shape": "square",   "io": "out" },
    { "id": "MIX_IN_TR",  "device": "MIX",   "x": 760, "y": 250, "shape": "triangle", "io": "in"  },
    { "id": "MIX_OUT_TR", "device": "MIX",   "x": 800, "y": 250, "shape": "triangle", "io": "out" },

