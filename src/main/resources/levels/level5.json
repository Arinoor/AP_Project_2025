    { "id": "REF_IN_SQ_2", "device": "REF", "x": 1020, "y": 230, "shape": "square",   "io": "in", "reference": true },
    { "id": "REF_IN_TR_1", "device": "REF", "x": 1020, "y": 270, "shape": "triangle", "io": "in", "reference": true },
    { "id": "REF_IN_TR_2", "device": "REF", "x": 1020, "y": 310, "shape": "triangle", "io": "in", "reference": true }
  ],

  "notes": "Wire SRC_A (square/infinite) -> VPN_IN_SQ -> VPN_OUT_SQ -> MIX_IN_SQ -> MIX_OUT_SQ -> REF square inputs. Wire SRC_B (triangle) -> VPN_IN_TR -> VPN_OUT_TR -> MIX_IN_TR -> MIX_OUT_TR -> REF triangle inputs. Wire SECURE outs to MIX-compatible inputs to create queueing. VPN converts messaging packets (square/triangle/infinite) into PROTECTED; their travel model is hidden and randomly emulates a messenger type per hop dispatch."
